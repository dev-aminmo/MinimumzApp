<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Native Universal Links — opens the app for /product /cart /r links.
	     IMPORTANT: must be a real HTTPS domain (not an IP), matching the API
	     host in module.dart. Host /.well-known/apple-app-site-association on it.
	     Enable "Associated Domains" in Xcode + the Apple Developer App ID.
	     TODO: replace with your production domain. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:darkorchid-mouse-412686.hostingersite.com</string>
	</array>
</dict>
</plist>
